# Copiez ce fichier en ".env" et adaptez les valeurs.

# Cle partagee entre Spring Boot et FastAPI.
# Mettez EXACTEMENT la meme valeur cote Spring (severity.ai.api-key).
# Laissez vide pour desactiver l'authentification (DEV uniquement).
SEVERITY_API_KEY=change-me-please-a-long-random-secret

# Version du modele (affichee dans les reponses et la sonde /health).
MODEL_VERSION=xgb-tfidf-1.0

# (Optionnel) chemin personnalise du modele .pkl
# MODEL_PATH=app/model/severity_model.pkl
