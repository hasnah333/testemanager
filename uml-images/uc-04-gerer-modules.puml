@startuml
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2E86C1
  ArrowColor #2E86C1
  ActorBorderColor #2E86C1
}
skinparam packageStyle rectangle
skinparam shadowing true
left to right direction

title Diagramme de cas d'utilisation "Gerer les modules"

actor "Testeur" as Testeur
actor "Manager" as Manager

rectangle "Gerer les modules" {
  (UC 4: Gerer les\nmodules) as UC4

  (UC 4.1: Creer un\nmodule) as UC41
  (UC 4.2: Afficher les\nmodules du projet) as UC42
  (UC 4.3: Modifier un\nmodule) as UC43
  (UC 4.4: Supprimer un\nmodule) as UC44
  (UC 4.2.1: Afficher details\nd'un module) as UC421
}

Testeur --> UC4
Manager --> UC4
UC4 ..> UC41 : <<extend>>
UC4 ..> UC42 : <<extend>>
UC4 ..> UC43 : <<extend>>
UC4 ..> UC44 : <<extend>>
UC42 ..> UC421 : <<include>>
@enduml
