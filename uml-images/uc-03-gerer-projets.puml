@startuml
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2E86C1
  ArrowColor #2E86C1
  ActorBorderColor #2E86C1
}
skinparam packageStyle rectangle
skinparam shadowing true
left to right direction

title Diagramme de cas d'utilisation "Gerer les projets"

actor "Admin" as Admin

rectangle "Gerer les projets (Admin uniquement)" {
  (UC 3: Gerer les\nprojets) as UC3

  (UC 3.1: Creer un\nprojet) as UC31
  (UC 3.2: Afficher la liste\ndes projets) as UC32
  (UC 3.3: Modifier un\nprojet) as UC33
  (UC 3.4: Supprimer un\nprojet) as UC34
  (UC 3.5: Archiver un\nprojet) as UC35
  (UC 3.6: Assigner un testeur\nau projet) as UC36
  (UC 3.7: Retirer un testeur\ndu projet) as UC37
  (UC 3.2.1: Afficher details\nd'un projet) as UC321
}

Admin --> UC3
UC3 ..> UC31 : <<extend>>
UC3 ..> UC32 : <<extend>>
UC3 ..> UC33 : <<extend>>
UC3 ..> UC34 : <<extend>>
UC3 ..> UC35 : <<extend>>
UC3 ..> UC36 : <<extend>>
UC3 ..> UC37 : <<extend>>
UC32 ..> UC321 : <<include>>
@enduml
