@startuml
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2E86C1
  ArrowColor #2E86C1
  ActorBorderColor #2E86C1
}
skinparam packageStyle rectangle
skinparam shadowing true
left to right direction

title Diagramme de cas d'utilisation "Gerer les sessions de test"

actor "Testeur" as Testeur
actor "Manager" as Manager

rectangle "Gerer les sessions de test" {
  (UC 7: Gerer les\nsessions de test) as UC7

  (UC 7.1: Creer une\nsession de test) as UC71
  (UC 7.2: Afficher les sessions\ndu projet) as UC72
  (UC 7.3: Modifier une\nsession) as UC73
  (UC 7.5: Cloturer une\nsession) as UC75
  (UC 7.6: Generer resume\nIA de la session) as UC76
  (UC 7.2.1: Afficher details\nd'une session) as UC721
}

Testeur --> UC7
Testeur --> UC71
Testeur --> UC73

Manager --> UC72
Manager --> UC721

UC7 ..> UC72 : <<extend>>
UC7 ..> UC71 : <<extend>>
UC7 ..> UC73 : <<extend>>
UC7 ..> UC75 : <<extend>>
UC75 ..> UC76 : <<include>>
UC72 ..> UC721 : <<include>>

note right of UC71 : Testeur/Admin\nuniquement
note right of UC72 : Testeur + Manager\n(consultation)
@enduml
