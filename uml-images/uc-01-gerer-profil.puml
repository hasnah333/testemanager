@startuml
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2E86C1
  ArrowColor #2E86C1
  ActorBorderColor #2E86C1
}
skinparam packageStyle rectangle
skinparam shadowing true
left to right direction

title Diagramme de cas d'utilisation "Gerer profil"

actor "Admin / Testeur /\nManager" as User

rectangle "Gerer profil" {
  (UC 1: Gerer profil) as UC1

  (UC 1.1: Afficher les\ninformations du profil) as UC11
  (UC 1.2: Modifier les\ninformations) as UC12
  (UC 1.3: Changer le\nmot de passe) as UC13
}

User --> UC1
UC1 ..> UC11 : <<extend>>
UC1 ..> UC12 : <<extend>>
UC1 ..> UC13 : <<extend>>
@enduml
