flowchart TD
    START(["Debut"]) --> A[Admin cree un Projet]
    A --> B[Admin cree les Modules]
    B --> C[Testeur cree les Scenarios]
    C --> D{"Import Excel ou saisie manuelle ?"}
    D -->|Import Excel| E[Testeur importe .xlsx]
    D -->|Saisie manuelle| F[Testeur cree cas de test]
    D -->|Generation IA| G2[IA genere les cas de test]
    E --> G[Cas de test crees]
    F --> G
    G2 --> G
    G --> H[Admin assigne les membres]
    H --> I[Testeur ouvre une Session de Test]
    I --> J[Testeur selectionne un Cas de Test]
    J --> K[Testeur execute le test]
    K --> L{"Resultat ?"}
    L -->|SUCCESS| M[Marque SUCCESS]
    L -->|FAILED| N[Marque FAILED]
    L -->|BLOCKED| O[Marque BLOCKED]
    N --> P[Declare une Anomalie]
    O --> P
    P --> Q{"Gravite ?"}
    Q -->|CRITIQUE| R[Notification auto Admin + Manager]
    Q -->|FAIBLE/MOYENNE| S[Enregistrement anomalie]
    R --> S
    M --> T{"Tous les tests executes ?"}
    S --> T
    T -->|Non| J
    T -->|Oui| U[IA genere resume de session]
    U --> V[Manager consulte les resultats]
    V --> W{"Resultats satisfaisants ?"}
    W -->|Non| X[Manager demande corrections]
    X --> J
    W -->|Oui| Y[Manager valide le Projet]
    Y --> Z[Admin archive le Projet]
    Z --> END(["Fin"])
