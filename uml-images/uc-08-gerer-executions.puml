@startuml
skinparam usecase {
  BackgroundColor #D6EAF8
  BorderColor #2E86C1
  ArrowColor #2E86C1
  ActorBorderColor #2E86C1
}
skinparam packageStyle rectangle
skinparam shadowing true
left to right direction

title Diagramme de cas d'utilisation "Gerer les executions"

actor "Testeur" as Testeur
actor "Manager" as Manager

rectangle "Gerer les executions" {
  (UC 8: Gerer les\nexecutions) as UC8

  (UC 8.1: Lancer une\nexecution) as UC81
  (UC 8.2: Afficher les executions\ndu cas de test) as UC82
  (UC 8.3: Mettre a jour\nle statut) as UC83
  (UC 8.4: Joindre une\ncapture d'ecran) as UC84
  (UC 8.2.1: Afficher details\nd'une execution) as UC821
}

Testeur --> UC8
UC8 ..> UC81 : <<extend>>
UC8 ..> UC82 : <<extend>>
UC8 ..> UC83 : <<extend>>
UC8 ..> UC84 : <<extend>>
UC82 ..> UC821 : <<include>>

Manager --> UC82
Manager --> UC821

note right of UC81 : Testeur uniquement\n(ADMIN aussi)
note right of Manager : Lecture seule\n(pas d'execution)
@enduml
